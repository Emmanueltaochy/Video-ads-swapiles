{
  "name": "swapiles-video-ads",
  "version": "1.0.0",
  "private": true,
  "description": "Publicités YouTube Swap'Îles (30 s + bumper 6 s) réalisées avec Remotion",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render:30s": "remotion render SwapilesAd30s out/swapiles-ad-30s.mp4",
    "render:bumper": "remotion render SwapilesBumper6s out/swapiles-bumper-6s.mp4",
    "render:all": "npm run render:30s && npm run render:bumper",
    "lint": "tsc --noEmit",
    "audio:voice": "python3 scripts/generate_voiceover.py",
    "audio:music": "python3 scripts/generate_music.py"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@remotion/cli": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/web": "^0.0.357",
    "typescript": "^7.0.2"
  }
}
